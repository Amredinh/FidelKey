{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "productName": "FidelKey",
  "version": "0.1.0",
  "identifier": "com.fidelkey.app",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FidelKey Settings",
        "width": 860,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
