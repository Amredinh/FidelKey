{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "publisher": "Afbix",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "productName": "FidelKey",
  "version": "0.1.0",
  "identifier": "afbix.fidelkey",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FidelKey Settings",
        "width": 860,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
